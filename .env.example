# ============================================================================
#  chert — Discord bridge + dashboard.  `./setup.sh` creates .env from this file and fills in
#  the Discord values for you. Otherwise: copy to .env, fill in, `chmod 600 .env`.
#  .env is gitignored and must NEVER be committed. Every value here is a placeholder.
#  Only the three marked (required) have no working default.
# ============================================================================

# ---------- Discord (setup_discord.py writes the ids) ----------
# The bot needs the MESSAGE CONTENT intent (Developer Portal → Bot → Privileged Gateway Intents).
DISCORD_BOT_TOKEN=                  # (required) bot token
DISCORD_CHANNEL_ID=                 # (required) #claudes — one thread per live claude
DISCORD_CHAT_CHANNEL_ID=            # #claude-chat — claude↔claude bus mirror (blank = find-or-create)
DISCORD_BROADCAST_CHANNEL_ID=       # #all-claudes — ask-every-claude channel (blank = find-or-create)
DISCORD_BROADCAST_CHANNEL_NAME=     # blank = all-claudes
DISCORD_OWNER_ID=                   # who gets pinged, and who may use owner-only commands (/model, /globalmodel); blank = server owner
PYTHONUNBUFFERED=1                  # (required) without it, print() never reaches journalctl
POLL_SECS=                          # blank = 4s registry poll (hooks make most updates instant)
PROMPT_CHANNEL_ID=                  # optional: a channel holding CLAUDE.md as an attachment, synced to disk
PROMPT_TARGET=                      # blank = ~/.claude/CLAUDE.md

# ---------- Links ----------
DASHBOARD_URL=                      # blank = http://127.0.0.1:8899/claudes; set to where you expose the dashboard (behind auth)
REPORTS_URL=                        # optional: a web server that serves REPORTS_DIR; blank = reports are linked by file path
CHAT_LOG=                           # blank = ~/shared/claude_chat/msgs.jsonl (the claude↔claude bus)

# ---------- Spawning claudes (/claude, @mention, !fork, !revive) ----------
PROJECT_ROOT=                       # blank = $HOME; a summon's optional first word resolves against this
TMUX_SESSION=0                      # tmux session new windows go into (chert-tmux.service keeps it alive)
CLAUDE_BIN=                         # blank = resolve via PATH, then ~/.local/bin/claude
# Flags for bot-spawned claudes. MUST be quoted — it contains spaces. The allow flag is what makes
# `!bypass` possible; drop it if you never want that.
SPAWN_FLAGS="--allow-dangerously-skip-permissions --effort xhigh"
PERMISSION_MODE=                    # blank = permissions.defaultMode from ~/.claude/settings.json
SPAWN_ALLOW_USERS=                  # blank = anyone in the server may launch claudes; else comma-separated user ids

# ---------- Persistence + the board ----------
REVIVE_ON_BOOT=1                    # after a reboot, resume every session that was live (into tmux)
REVIVE_ON_CRASH=0                   # also resume sessions that died without a clean exit (crash-loop risk)
ENDED_KEEP_DAYS=14                  # how long ended sessions stay revivable from their thread
ANNOUNCE_NEW=0                      # 1 = a line in #claudes for every new session and end (noisy)
BOARD=1                             # one pinned status board in #claudes, edited in place (never pings)

# ---------- Disk watchdog + Ash Twin (S3) — optional ----------
S3_BUCKET=                          # your PRIVATE bucket; blank disables backup/offload/restore
DISK_WARN_GB=15                     # post to #claudes below this much free space
DISK_CRIT_GB=5                      # …and ping the owner below this
AUTO_OFFLOAD=0                      # 1 = when critical, offload the biggest cold dir automatically (deletes the local copy after a verified upload)
ASH_HOME=                           # blank = $HOME; root that offload/backup paths are relative to
ASH_MANIFEST=                       # blank = ~/.claude/ash-twin-manifest.json

# ---------- Feldspar (deep review: "let feldspar look into this") ----------
FELDSPAR_CLAUDE_MODEL=fable         # runs as a real tmux session/thread with agent teams
FELDSPAR_CLAUDE_EFFORT=max
FELDSPAR_OPENAI_MODEL=gpt-6-astra   # second reviewer via `codex exec` (needs `codex login`)
FELDSPAR_OPENAI_EFFORT=ultra
FELDSPAR_TIMEOUT=10800              # seconds before the codex side is killed
FELDSPAR_CODEX_SANDBOX=read-only
FELDSPAR_CODEX_UNSANDBOXED_FALLBACK=1   # retry unsandboxed if bubblewrap can't start (see sandbox/)
REPORTS_DIR=                        # blank = ~/shared/reports
CODEX_BIN=                          # blank = resolve via PATH, then ~/.local/bin/codex
CODEX_BRIDGE_HOME=                  # blank = ~/.codex-bridge (a private CODEX_HOME so two codex versions can't fight over the model cache)

# ---------- Astra (GPT sessions as threads) ----------
ASTRA_MODEL=gpt-6-astra
ASTRA_EFFORT=xhigh                  # per thread: !effort low|medium|high|xhigh|max|ultra
ASTRA_SANDBOX=workspace-write       # danger-full-access is used automatically if bubblewrap can't start
ASTRA_TURN_TIMEOUT=10800
ASTRA_RETRIES=2
ASTRA_LOG_DIR=                      # blank = ~/shared/astra
ASTRA_HANDOFF_CHARS=400000          # !fork astra: how much of the claude conversation is handed over

# ---------- #all-claudes ask-rounds ----------
ASK_COLLECT_SECS=240                # how long to wait for every claude's reply
ASK_HUB_NAME=all-claudes-hub        # the persistent summarizer session
ASK_DIR=                            # blank = ~/shared/all-claudes (round briefs)

# ---------- Hooks + files ----------
# hooks/install_hooks.py (run by setup.sh) adds chert's hooks to ~/.claude/settings.json.
HEARTH_HOOK_PORT=8897               # bridge listens on 127.0.0.1:<port>
HEARTH_HOOK_SECRET=                 # blank = ~/.claude/hearth-hook.secret (created by the installer)
HEARTH_HOOK_SPOOL=                  # blank = ~/.claude/hearth-events (events queued while the bridge is down)
HEARTH_FILE_LIMIT=26214400          # bytes; bigger files/images are linked by path instead of uploaded
ATTACH_DIR=                         # blank = ~/shared/uploads (attachments you post in threads)

# ---------- Cosmetics ----------
AVATAR_URL=                         # optional: image URL for every claude's webhook face; `{seed}` → per-claude
AVATAR_FILE=                        # optional: a LOCAL image uploaded onto the webhook (keep it outside the repo)

# ---------- Dashboard (app.py) + its optional auth proxy (dashboard_proxy.py) ----------
CLAUDE_HOME=                        # blank = ~/.claude (session registry + transcripts)
CLAUDE_SETTINGS=                    # blank = ~/.claude/settings.json
DASH_USER=                          # dashboard_proxy.py only — required there, no default on purpose
DASH_PASS=
DASH_UPSTREAM=                      # blank = http://127.0.0.1:8899

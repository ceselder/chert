# Ubuntu 24.04 restricts unprivileged user namespaces
# (kernel.apparmor_restrict_unprivileged_userns=1). Without a profile, bubblewrap can
# create the namespace but has no capabilities inside it, so Codex's Linux sandbox dies
# with "bwrap: loopback: Failed RTM_NEWADDR: Operation not permitted" before running
# any command. This is the same shape as Ubuntu's own bwrap-userns-restrict profile:
# it grants bwrap the right to use user namespaces and otherwise leaves it unconfined
# (bwrap does its own confinement of the child).
abi <abi/4.0>,
include <tunables/global>

profile bwrap-userns-restrict /usr/bin/bwrap flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/bwrap-userns-restrict>
}

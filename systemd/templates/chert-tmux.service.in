[Unit]
Description=chert: persistent tmux server (session "0" that every claude lives in)
After=network.target

[Service]
Type=forking
User=@USER@
Group=@USER@
WorkingDirectory=@HOME@
# The bridge spawns claudes with `tmux new-window -t "$TMUX_SESSION:"` (default session 0);
# without a live session named 0, summons fail silently.
ExecStart=/usr/bin/tmux new-session -d -s 0
ExecStop=/usr/bin/tmux kill-server
RemainAfterExit=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
